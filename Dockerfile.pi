# node:24-trixie (glibc 2.41) — rtk's aarch64 Linux build requires glibc >= 2.39 (bookworm has 2.36)
FROM node:24-trixie-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates curl git ripgrep \
       python3 python3-pip python3-venv python-is-python3 \
  && rm -rf /var/lib/apt/lists/*

# rtk — Rust Token Killer (compresses bash output for the agent).
# Pin to a release; update-pi-sandbox.ps1 bumps this and rebuilds the image.
# Default edition (Apache-2.0 + BUSL-1.1): it keeps the compression engine that
# rtk-oss drops. x86_64 ships musl (static), aarch64 ships gnu.
ARG RTK_VERSION=v1.0.1
# SHA-256 of each release tarball, from that release's checksums.txt. A tag is
# movable, so update-pi-sandbox.ps1 repins these together with RTK_VERSION; the
# build verifies the download against them (see the sha256sum check below).
ARG RTK_SHA256_X86_64=5b919c3bccb799b67a61866d0e617410a4fcdf173e2614440e59de2fa2003436
ARG RTK_SHA256_AARCH64=cd627c4091ad90b5e5aca83ca5af66ee4b8aa8537a736533fa90544f461f1c2b
RUN case "$(uname -m)" in \
       x86_64)  TARGET=x86_64-unknown-linux-musl; SHA="${RTK_SHA256_X86_64}" ;; \
       aarch64) TARGET=aarch64-unknown-linux-gnu; SHA="${RTK_SHA256_AARCH64}" ;; \
       *) echo "unsupported arch: $(uname -m)" >&2; exit 1 ;; \
     esac \
  && curl -fsSL -o /tmp/rtk.tar.gz \
     "https://github.com/rtk-ai/rtk/releases/download/${RTK_VERSION}/rtk-${TARGET}.tar.gz" \
  && echo "${SHA}  /tmp/rtk.tar.gz" | sha256sum -c - \
  && tar -xzf /tmp/rtk.tar.gz -C /tmp \
  && install -m 0755 /tmp/rtk /usr/local/bin/rtk \
  && rm -rf /tmp/rtk.tar.gz /tmp/rtk \
  && rtk --version

# pi, as Pi-Bolt (https://github.com/opensec-git/Pi-Bolt): pi compiled ahead of
# time to native code. Pinned; update-pi-sandbox.ps1 bumps this and rebuilds.
# No hash to pin: SHA256SUMS is checked against its Ed25519 signature (the
# release key below, as in Pi-Bolt's own installer), then the tarball against
# SHA256SUMS. The binary needs its sibling files (themes, wasm…): keep the folder.
# Also linked as `pi-bolt`: the name Pi-Bolt prints in its own hints.
ARG PIBOLT_VERSION=1.0.1
ARG PIBOLT_SIGNER=MCowBQYDK2VwAyEAoLboJqtKaoISPqffk03vHZr+1sRBG3uIRIWeKOew+aY=
RUN case "$(uname -m)" in \
       x86_64)  TARGET=linux-x64 ;; \
       aarch64) TARGET=linux-arm64 ;; \
       *) echo "unsupported arch: $(uname -m)" >&2; exit 1 ;; \
     esac \
  && B="https://github.com/opensec-git/Pi-Bolt/releases/download/bolt-v${PIBOLT_VERSION}" \
  && mkdir /tmp/pb && cd /tmp/pb \
  && curl -fsSL -o SHA256SUMS "$B/SHA256SUMS" -o SHA256SUMS.sig "$B/SHA256SUMS.sig" -o "pi-bolt-$TARGET.tar.gz" "$B/pi-bolt-$TARGET.tar.gz" \
  && node -e 'const c=require("crypto"),f=require("fs");const k=c.createPublicKey({key:Buffer.from(process.argv[1],"base64"),format:"der",type:"spki"});if(!c.verify(null,f.readFileSync("SHA256SUMS"),k,f.readFileSync("SHA256SUMS.sig"))){console.error("Pi-Bolt: bad SHA256SUMS signature");process.exit(1)}' "$PIBOLT_SIGNER" \
  && grep -qx "# pi-bolt ${PIBOLT_VERSION}" SHA256SUMS \
  && grep " pi-bolt-$TARGET.tar.gz\$" SHA256SUMS | sha256sum -c - \
  && mkdir -p /opt/pi-bolt && tar -xzf "pi-bolt-$TARGET.tar.gz" -C /opt/pi-bolt --strip-components=1 \
  && ln -s /opt/pi-bolt/pi /usr/local/bin/pi \
  && ln -s /opt/pi-bolt/pi /usr/local/bin/pi-bolt \
  && cd / && rm -rf /tmp/pb \
  && pi --version

# Updates come from rebuilding the image: no pi.dev check, no install telemetry.
# Never run `pi update` in the container (it would write into a --rm image).
ENV PI_SKIP_VERSION_CHECK=1 PI_TELEMETRY=0

WORKDIR /workspace
ENTRYPOINT ["pi"]
